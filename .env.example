# Salin ke .env.local lalu isi. Di Vercel: Project Settings → Environment Variables.

# MongoDB Atlas → Connect → Drivers. Network Access wajib mengizinkan 0.0.0.0/0 (untuk Vercel).
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/resi-layanan?retryWrites=true&w=majority"

# Minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
# Juga menjadi kunci perlindungan NIK (hash & enkripsi) bila PII_SECRET kosong: jangan diganti
# setelah ada data, karena NIK lama tidak akan bisa dicari/dibuka lagi.
SESSION_SECRET=""

# Opsional. Kunci terpisah untuk NIK (minimal 32 karakter); kosong = turunan SESSION_SECRET.
PII_SECRET=""

# Kata sandi semua akun demo yang dibuat `npm run seed` (minimal 8 karakter).
DEMO_PASSWORD=""

# Opsional. Alamat publik situs (untuk QR & tautan di email), mis. https://resi-layanan.vercel.app.
# Kosong = diambil dari alamat yang sedang dibuka.
SITE_URL=""

# Opsional. Notifikasi email ke warga lewat Resend (resend.com). Kosong = email hanya dicatat di log server.
RESEND_API_KEY=""
EMAIL_FROM="Pantas <notifikasi@domain-anda.id>"
